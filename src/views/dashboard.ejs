<%- include('partials/header') %>

<main>
  <div class="wrapper dashboard-page">
    <div class="dashboard-card">
      <h1>Dashboard</h1>
      <p class="welcome">Welcome, <%= name %> (<%= email %>)</p>

      <div class="dashboard-actions">
        <% if (user && user.role_name === 'admin') { %>
          <a href="/users">View All Users</a>
        <% } %>
      </div>
      
      <div class="volunteer-list">
        <h2>Your Volunteering</h2>
        <% if (volunteerProjects && volunteerProjects.length) { %>
          <ul>
            <% volunteerProjects.forEach(p => { %>
              <li>
                <a href="/project/<%= p.project_id %>"><%= p.title %></a>
                <form action="/project/<%= p.project_id %>/unvolunteer" method="POST" style="display:inline">
                  <button type="submit">Remove</button>
                </form>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p>You are not signed up to volunteer for any projects.</p>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>