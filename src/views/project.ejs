<%- include('partials/header') %>
<main>
  <div class="wrapper">
    <div class="project">
    <h1><%= project.title %></h1>

    <p><strong>Organization:</strong>
      <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>

    <p><strong>Date:</strong>
      <% if (project.date) { %><%= new Date(project.date).toISOString().slice(0,10) %><% } else { %>TBA<% } %>
    </p>

    <p><strong>Location:</strong> <%= project.location %></p>

    <% if (project.categories && project.categories.length) { %>
  <div class="project-tags">
    <% project.categories.forEach(cat => { %>
      <a class="tag" href="/category/<%= cat.category_id %>"><%= cat.name %></a>
    <% }) %>
  </div>
<% } %>

    <section>
      <h2>Description</h2>
      <p><%= project.description %></p>
    </section>

    <% if (isLoggedIn) { %>
      <% if (project.isVolunteer) { %>
        <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
          <button type="submit">Remove Myself as Volunteer</button>
        </form>
      <% } else { %>
        <form action="/project/<%= project.project_id %>/volunteer" method="POST">
          <button type="submit">Volunteer for this project</button>
        </form>
      <% } %>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
  <p class="edit-organization">
    <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
    <a href="/project/<%= project.project_id %>/assign-categories">Assign Categories</a>
  </p>
<% } %>
  </div>
  </div>
</main>
<%- include('partials/footer') %>