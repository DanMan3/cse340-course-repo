<%- include('partials/header') %>

<main>
    <div class="wrapper">
        <h1><%= title %></h1>

        <h2>Upcoming Service Projects</h2>
        <ul id="projects-list">
            <% if (projects && projects.length) { %>
                <% projects.forEach(project => { %>
                    <li>
                        <%= new Date(project.date).toLocaleDateString() %>: <strong><%= project.title %></strong>
                        (<%= project.organization_name %>)<br>
                        <small><%= project.location %></small><br>
                        <p><%= project.description %></p>
                    </li>
                <% }) %>
            <% } else { %>
                <li>No upcoming projects found.</li>
            <% } %>
        </ul>
    </div>
</main>

<%- include('partials/footer') %>