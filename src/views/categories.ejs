<%- include('partials/header') %>

<main>
  <div class="wrapper">

    <h1><%= title %></h1>
    
    <h2>Service Project Categories</h2>
    <ul id="service-project-categories">
      <% if (categories && categories.length) { %>
        <% categories.forEach(category => { %>
          <li><%= category.name %></li>
        <% }) %>
      <% } else { %>
        <li>No categories found.</li>
      <% } %>
    </ul>
  </div>
</main>

<%- include('partials/footer') %>