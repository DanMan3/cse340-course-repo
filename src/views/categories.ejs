<%- include('partials/header') %>

<main>
  <div class="wrapper">

    <h1><%= title %></h1>
    
    <h2>Service Project Categories</h2>

<ul id="service-project-categories">
  <% if (categories && categories.length) { %>
    <% categories.forEach(category => { %>
      <li>
        <a class="category-name" href="/category/<%= category.category_id %>"><%= category.name %></a>
        <% if (user && user.role_name === 'admin') { %>
          <a class="edit-category-link edit-organization" href="/edit-category/<%= category.category_id %>">Edit</a>
        <% } %>
      </li>
    <% }) %>
  <% } else { %>
    <li>No categories found.</li>
  <% } %>
</ul>
  <% if (user && user.role_name === 'admin') { %>
    <p class="create-category new-organization-link"><a href="/new-category">Create Category</a></p>
  <% } %>
  </div>
</main>

<%- include('partials/footer') %>