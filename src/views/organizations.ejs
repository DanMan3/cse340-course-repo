<%- include('partials/header') %>
<main>
      <div class="wrapper">

  <h1><%= title %></h1>

  <p>Here are a few of our partner organizations:</p>
  <ul id="organizations-list">
    <% if (organizations && organizations.length) { %>
      <% organizations.forEach(organization => { %>
        <li>
          <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
          <a href="/organization/<%= organization.organization_id %>"><strong><%= organization.name %></strong></a>
           <%= organization.contact_email %>
        </li>
      <% }) %>
    <% } else { %>
      <li>No organizations found.</li>
    <% } %>
  </ul>
  <% if (user && user.role_name === 'admin') { %>
    <p class="new-organization-link"><a href="/new-organization">Add a new organization</a></p>
  <% } %>
</div>
</main>
<%- include('partials/footer') %>