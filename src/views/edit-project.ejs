<%- include('partials/header') %>
<main>
  <div class="wrapper">
    <h1><%= title %></h1>

    <form action="/edit-project/<%= project.project_id %>" method="POST" id="edit-project-form">
      <div class="form-group">
        <label for="organizationId">Organization</label>
        <select id="organizationId" name="organizationId" required>
          <option value="">Select an organization</option>
          <% organizations.forEach(org => { %>
            <option value="<%= org.organization_id %>" <%= Number(project.organization_id) === Number(org.organization_id) ? 'selected' : '' %>><%= org.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="title">Project Title</label>
        <input type="text" id="title" name="title" value="<%= project.title %>" required maxlength="200" />
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" required maxlength="1000"><%= project.description %></textarea>
      </div>

      <div class="form-group">
        <label for="location">Location</label>
        <input type="text" id="location" name="location" value="<%= project.location %>" required maxlength="200" />
      </div>

      <div class="form-group">
        <label for="date">Date</label>
        <input type="date" id="date" name="date" value="<%= project.date ? new Date(project.date).toISOString().slice(0,10) : '' %>" required />
      </div>

      <button type="submit">Save Project</button>
    </form>

    <p class="edit-organization"><a href="/project/<%= project.project_id %>">Cancel</a></p>
  </div>
</main>
<%- include('partials/footer') %>